# ==============================================================================
# Google Gemini API Configuration
# Rename this file to '.env' and insert your valid Gemini API key.
# Get your free API key at: https://aistudio.google.com/app/apikey
# Never commit your actual '.env' file to GitHub or version control.
# ==============================================================================

# Google Gemini API Key (Recommended)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback compatibility: LLM_API_KEY is also supported if preferred
# LLM_API_KEY=your_gemini_api_key_here
